{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notely",
  "version": "0.1.0",
  "identifier": "com.notely.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Notely",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A focused personal text editor",
    "longDescription": "Notely is a lightweight personal text editor."
  }
}
